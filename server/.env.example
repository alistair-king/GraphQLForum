# Server port
PORT=4000

# MySQL (defaults match docker-compose.yml at the repo root)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=graphqlforum
DB_USER=graphqlforum
DB_PASSWORD=graphqlforum

# TypeORM: auto-sync schema on boot (convenient in dev, do not use in production)
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Auth0 (server-side token verification).
# Create an API in the Auth0 dashboard; its identifier is the audience.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_ISSUER=https://your-tenant.eu.auth0.com/

# Custom claim namespace used for role claims (must match the client's
# VITE_AUTH0_NAMESPACE and the namespace used in your Auth0 Action)
AUTH0_NAMESPACE=https://graphqlforum.com
