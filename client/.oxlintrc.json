{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-unused-vars": [
      "error",
      {
        "args": "none"
      }
    ],
    "typescript/no-explicit-any": "off",
    "react/static-components": "off"
  },
  "ignorePatterns": [
    "dist",
    "coverage",
    "node_modules"
  ]
}