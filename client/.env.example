# GraphQL endpoint. Leave unset to use the Vite dev proxy (/graphql -> http://localhost:4000).
# VITE_GRAPHQL_ENDPOINT=http://localhost:4000/graphql

# Auth0 SPA application (from the Auth0 dashboard -> Applications)
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENTID=your-spa-client-id
# The API identifier created in the Auth0 dashboard (must match AUTH0_AUDIENCE on the server)
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# Custom claim namespace used for role claims (must match AUTH0_NAMESPACE on the server)
VITE_AUTH0_NAMESPACE=https://graphqlforum.com
